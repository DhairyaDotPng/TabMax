{
  "manifest_version": 3,
  "name": "TabMax",
  "short_name": "TabMax",
  "version": "1.0.1",
  "description": "Modern, minimalist new tab page with Shadcn UI, quick bookmark bar, organized cards, instant search, and notes.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "bookmarks",
    "favicon",
    "search",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*.open-meteo.com/*"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  }
}
